# ==============================================================================
# ONSPOT - Environment Variables Template
# Copy this file to .env.local and replace with your project values:
#   cp .env.example .env.local
# ==============================================================================

# Supabase Public API (Accessible by client & server)
# Find these in your Supabase dashboard: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# Used for administrative backend tasks and elevated database access
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Demo Mode Credentials
# When enabled, a quick demo login button appears in the login modal
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=demo@onspot.app
NEXT_PUBLIC_DEMO_PASSWORD=demo-password-123
